# =============================================================================
# DocuNOVA — Variables de entorno
# Copia este archivo como `.env.local` para desarrollo local, y carga estas
# mismas variables en Vercel (Settings → Environment Variables) para producción.
#
# Las dos primeras son PÚBLICAS por diseño (la anon key está pensada para el
# navegador). Se obtienen en Supabase → Project Settings → API.
# =============================================================================

# Project URL (Supabase → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon / public key (Supabase → Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# service_role key (Supabase → Settings → API → Project API keys → service_role).
# SECRETA: solo servidor, NUNCA con prefijo NEXT_PUBLIC_. Habilita la función
# "Ver como" (impersonación) del módulo de Gestión: el servidor forja la sesión
# del usuario objetivo y firma el marcador de impersonación con esta clave. Si
# se omite, la app funciona igual pero "Ver como" queda deshabilitada.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional: token que protege la ruta pública /api/keepalive (el latido que
# evita la pausa del Plan Free de Supabase). Si se define, el cron externo debe
# enviarlo en la cabecera `Authorization: Bearer …`. Si se omite, la ruta queda
# abierta (solo registra un latido, no expone datos).
# KEEPALIVE_SECRET=una-cadena-larga-aleatoria

# Opcional: dominio institucional permitido para el login.
# Por defecto es cotecnova.edu.co; descoméntalo solo si cambia.
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=cotecnova.edu.co

# -----------------------------------------------------------------------------
# Google Drive institucional para los archivos de Memoria Corporativa (opcional)
# Si estas variables faltan, los archivos se guardan en el bucket 'memoria' de
# Supabase Storage. Paso a paso de la vinculación: docs/DRIVE.md
# -----------------------------------------------------------------------------

# Correo de la cuenta de servicio de Google Cloud (campo client_email del JSON).
# GOOGLE_DRIVE_CLIENT_EMAIL=docunova-drive@tu-proyecto.iam.gserviceaccount.com

# Clave privada de esa cuenta (campo private_key del JSON). SECRETA.
# Admite saltos de línea reales o "\n" literales.
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID de la carpeta destino en Drive (se lee de la URL de la carpeta).
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz123456

# Solo con delegación de todo el dominio: usuario a suplantar, para que los
# archivos queden a nombre de la cuenta institucional.
# GOOGLE_DRIVE_SUBJECT=docunova@cotecnova.edu.co
