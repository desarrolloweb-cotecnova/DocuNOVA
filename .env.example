# =============================================================================
# DocuNOVA — Variables de entorno
# Copia este archivo como `.env.local` para desarrollo local, y carga estas
# mismas variables en Vercel (Settings → Environment Variables) para producción.
#
# Las dos primeras son PÚBLICAS por diseño (la anon key está pensada para el
# navegador). Se obtienen en Supabase → Project Settings → API.
# =============================================================================

# Project URL (Supabase → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon / public key (Supabase → Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# service_role key (Supabase → Settings → API → Project API keys → service_role).
# SECRETA: solo servidor, NUNCA con prefijo NEXT_PUBLIC_. Habilita la función
# "Ver como" (impersonación) del módulo de Gestión: el servidor forja la sesión
# del usuario objetivo y firma el marcador de impersonación con esta clave. Si
# se omite, la app funciona igual pero "Ver como" queda deshabilitada.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional: dominio institucional permitido para el login.
# Por defecto es cotecnova.edu.co; descoméntalo solo si cambia.
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=cotecnova.edu.co
